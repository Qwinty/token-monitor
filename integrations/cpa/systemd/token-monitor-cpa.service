[Unit]
Description=CPA account quota collector for Token Monitor
After=network-online.target token-monitor-hub.service
Wants=network-online.target token-monitor-hub.service

[Service]
Type=simple
WorkingDirectory=/opt/token-monitor
EnvironmentFile=/opt/cpa-manager-plus/.env
EnvironmentFile=/opt/token-monitor/.env
ExecStart=/usr/bin/python3 /opt/token-monitor/integrations/cpa/collector.py
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/token-monitor/data

[Install]
WantedBy=multi-user.target
