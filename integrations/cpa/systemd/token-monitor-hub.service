[Unit]
Description=Token Monitor private quota Hub
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/token-monitor
EnvironmentFile=/opt/token-monitor/.env
ExecStart=/usr/bin/node /opt/token-monitor/src/hub/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/token-monitor/data

[Install]
WantedBy=multi-user.target
